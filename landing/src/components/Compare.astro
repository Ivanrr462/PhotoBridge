---
import Icon from "./Icon.astro";

const before = [
  "Buscar el cable, el adaptador y que el ordenador reconozca el móvil",
  "Enviarte las fotos por WhatsApp y que lleguen comprimidas",
  "Mandártelas por correo de cinco en cinco",
  "Subirlas a la nube para volver a descargarlas",
];

const after = [
  "Escaneas un QR y ya está conectado",
  "Fotos y vídeos en calidad original",
  "Cientos de fotos de una vez",
  "Todo se queda en tu casa",
];
---

<section class="section compare-section">
  <div class="container">
    <div class="section-head" data-reveal>
      <span class="eyebrow">Antes y después</span>
      <h2>Olvídate de los <span class="gradient-text">apaños de siempre</span></h2>
    </div>

    <div class="compare">
      <div class="col col-before" data-reveal>
        <h3>Hasta ahora</h3>
        <ul>
          {
            before.map((text) => (
              <li>
                <span class="mark mark-x">
                  <Icon name="x" size={14} strokeWidth={3} />
                </span>
                {text}
              </li>
            ))
          }
        </ul>
      </div>

      <div class="col col-after" data-reveal style="--delay: 120ms">
        <h3>
          <img src="/logo.svg" alt="" width="28" height="28" />
          Con PhotoBridge
        </h3>
        <ul>
          {
            after.map((text) => (
              <li>
                <span class="mark mark-ok">
                  <Icon name="check" size={14} strokeWidth={3} />
                </span>
                {text}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .compare-section {
    padding-top: 0;
  }
  .compare {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    max-width: 960px;
    margin-inline: auto;
  }
  .col {
    padding: 32px;
    border-radius: var(--radius-lg);
  }
  .col h3 {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 1.3rem;
    margin-bottom: 20px;
  }
  .col ul {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .col li {
    display: flex;
    align-items: flex-start;
    gap: 12px;
  }
  .mark {
    flex: none;
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    margin-top: 1px;
    border-radius: 50%;
  }
  .col-before {
    background: var(--bg-soft);
    border: 1px solid var(--border);
    color: var(--muted);
  }
  .col-before h3 {
    color: var(--muted);
  }
  .mark-x {
    background: rgb(240 68 56 / 0.12);
    color: #f04438;
  }
  .col-after {
    position: relative;
    background: var(--surface);
    box-shadow: var(--shadow-lg);
    font-weight: 500;
  }
  .col-after::before {
    content: "";
    position: absolute;
    inset: 0;
    padding: 2px;
    border-radius: inherit;
    background: var(--grad);
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask: linear-gradient(#000 0 0) content-box exclude, linear-gradient(#000 0 0);
    pointer-events: none;
  }
  .mark-ok {
    background: var(--grad);
    color: #fff;
  }

  @media (max-width: 760px) {
    .compare {
      grid-template-columns: 1fr;
    }
  }
</style>
