---
// Escena del hero: el móvil enviando fotos y la carpeta del PC llenándose.
import Icon from "./Icon.astro";
import Scene from "./Scene.astro";

const phoneThumbs = Array.from({ length: 9 }, (_, i) => i);
const FRESH_FROM = 5; // las últimas fotos "llegan" con animación
const files = Array.from({ length: 8 }, (_, i) => ({ variant: (i * 3 + 1) % 8, name: `IMG_${2031 + i}.jpg` }));
---

<div class="showcase" aria-hidden="true">
  <!-- Ordenador -->
  <div class="monitor">
    <div class="screen">
      <div class="titlebar">
        <i></i><i></i><i></i>
        <span><Icon name="folder" size={12} /> Imágenes › PhotoBridge</span>
      </div>
      <div class="files">
        {
          files.map((file, i) => (
            <div class:list={["file", { fresh: i >= FRESH_FROM }]} style={`--i: ${i - FRESH_FROM}`}>
              <div class="file-thumb">
                <Scene variant={file.variant} />
              </div>
              <span>{file.name}</span>
            </div>
          ))
        }
      </div>
    </div>
    <div class="neck"></div>
    <div class="foot"></div>
  </div>

  <!-- Notificación -->
  <div class="toast">
    <img src="/favicon.svg" alt="" />
    <div>
      <strong>18 fotos recibidas</strong>
      <small>Guardadas en Imágenes</small>
    </div>
    <span class="toast-check"><Icon name="check" size={12} strokeWidth={3} /></span>
  </div>

  <!-- Wifi -->
  <div class="wifi-chip">
    <span class="pulse"></span>
    <Icon name="wifi" size={14} strokeWidth={2.4} />
    Por tu wifi
  </div>

  <!-- Móvil -->
  <div class="phone">
    <div class="phone-screen">
      <div class="status">
        <span>9:41</span>
        <span class="island"></span>
        <span class="signal"><i></i><i></i><i></i></span>
      </div>
      <div class="app-head">
        <img src="/favicon.svg" alt="" />
        <div>
          <strong>PhotoBridge</strong>
          <small><i class="dot"></i>Conectado a TU-PC</small>
        </div>
      </div>
      <p class="sending">Enviando <b>18 de 24</b></p>
      <div class="bar"><span></span></div>
      <div class="thumbs">
        {
          phoneThumbs.map((i) => (
            <div class:list={["thumb", { done: i < 6, current: i === 6, pending: i > 6 }]}>
              <Scene variant={i} />
              {i < 6 && (
                <span class="badge">
                  <Icon name="check" size={10} strokeWidth={3.5} />
                </span>
              )}
            </div>
          ))
        }
      </div>
      <div class="note">Deja esta página abierta</div>
    </div>
  </div>
</div>

<style>
  .showcase {
    container-type: inline-size;
    position: relative;
    width: 100%;
    max-width: 620px;
    margin-inline: auto;
    aspect-ratio: 600 / 500;
  }

  /* ---------- Ordenador ---------- */
  .monitor {
    position: absolute;
    top: 4%;
    right: 0;
    width: 80%;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .screen {
    width: 100%;
    aspect-ratio: 16 / 10.4;
    border: 1.5cqw solid #12152a;
    border-radius: 3cqw;
    background: var(--surface);
    overflow: hidden;
    box-shadow: var(--shadow-lg);
    font-size: 1.75cqw;
  }
  .titlebar {
    display: flex;
    align-items: center;
    gap: 0.45em;
    padding: 0.9em 1.1em;
    border-bottom: 1px solid var(--border);
    color: var(--muted);
    font-weight: 500;
  }
  .titlebar i {
    width: 0.75em;
    height: 0.75em;
    border-radius: 50%;
    background: var(--border-strong);
  }
  .titlebar span {
    display: flex;
    align-items: center;
    gap: 0.4em;
    margin-left: 0.6em;
  }
  .titlebar svg {
    width: 1.1em;
    height: 1.1em;
  }
  .files {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.3em 0.9em;
    padding: 1.6em 1.4em;
  }
  .file {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.35em;
    min-width: 0;
  }
  .file-thumb {
    width: 100%;
    aspect-ratio: 4 / 3;
    border-radius: 0.6em;
    overflow: hidden;
    box-shadow: var(--shadow-sm);
  }
  .file span {
    font-size: 0.78em;
    color: var(--muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 100%;
  }
  .file.fresh {
    animation: arrive 6s cubic-bezier(0.2, 0.8, 0.2, 1) infinite;
    animation-delay: calc(var(--i) * 0.5s);
  }
  .file.fresh .file-thumb {
    outline: 0.18em solid transparent;
    animation: ring 6s ease infinite;
    animation-delay: calc(var(--i) * 0.5s);
  }
  @keyframes arrive {
    0%,
    8% {
      opacity: 0;
      transform: scale(0.6) translateY(0.6em);
    }
    18%,
    92% {
      opacity: 1;
      transform: none;
    }
    100% {
      opacity: 0;
    }
  }
  @keyframes ring {
    15%,
    35% {
      outline-color: #4353ff;
    }
    55% {
      outline-color: transparent;
    }
  }
  .neck {
    width: 12%;
    height: 7cqw;
    background: linear-gradient(#1c2040, #12152a);
  }
  .foot {
    width: 30%;
    height: 1.4cqw;
    border-radius: 1cqw 1cqw 0.4cqw 0.4cqw;
    background: #12152a;
  }

  /* ---------- Notificación ---------- */
  .toast {
    position: absolute;
    top: 0;
    right: -3%;
    display: flex;
    align-items: center;
    gap: 0.7em;
    padding: 0.8em 1em;
    border-radius: 1em;
    background: color-mix(in srgb, var(--surface) 88%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid var(--border);
    box-shadow: var(--shadow-md);
    font-size: max(11px, 2.1cqw);
    line-height: 1.25;
    animation: float 6s ease-in-out infinite;
  }
  @container (max-width: 440px) {
    .toast {
      top: -9%;
      right: 0;
      font-size: 9.5px;
      padding: 0.6em 0.8em;
    }
    .wifi-chip {
      font-size: 9.5px;
    }
  }
  .toast img {
    width: 2.4em;
    height: 2.4em;
  }
  .toast strong {
    display: block;
    font-weight: 650;
  }
  .toast small {
    color: var(--muted);
    font-size: 0.85em;
  }
  .toast-check {
    display: grid;
    place-items: center;
    width: 1.6em;
    height: 1.6em;
    margin-left: 0.4em;
    border-radius: 50%;
    background: var(--ok);
    color: #fff;
  }

  /* ---------- Chip wifi ---------- */
  .wifi-chip {
    position: absolute;
    left: 37%;
    bottom: 14%;
    display: flex;
    align-items: center;
    gap: 0.45em;
    padding: 0.55em 0.95em;
    border-radius: 999px;
    background: var(--grad);
    color: #fff;
    font-size: max(11px, 2cqw);
    font-weight: 600;
    box-shadow: var(--glow);
    animation: float 6s ease-in-out infinite reverse;
  }
  .pulse {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    border: 2px solid #5b6cff;
    animation: pulse 2.4s ease-out infinite;
  }
  @keyframes pulse {
    from {
      transform: scale(1);
      opacity: 0.8;
    }
    to {
      transform: scale(1.5, 1.9);
      opacity: 0;
    }
  }
  @keyframes float {
    50% {
      transform: translateY(-6px);
    }
  }

  /* ---------- Móvil ---------- */
  .phone {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 34%;
    aspect-ratio: 9 / 18.5;
    padding: 1.3cqw;
    border-radius: 6.4cqw;
    background: linear-gradient(145deg, #2a2f52, #0f1222);
    box-shadow: var(--shadow-lg), inset 0 0 0 1px rgb(255 255 255 / 0.08);
  }
  .phone-screen {
    height: 100%;
    display: flex;
    flex-direction: column;
    padding: 0.9em 1em 1em;
    border-radius: 5.2cqw;
    background: #f6f7fc;
    color: #0f1222;
    font-size: 1.85cqw;
    line-height: 1.3;
    overflow: hidden;
  }
  .status {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-weight: 600;
    font-size: 0.85em;
  }
  .island {
    width: 32%;
    height: 1.35em;
    border-radius: 999px;
    background: #0f1222;
  }
  .signal {
    display: flex;
    align-items: flex-end;
    gap: 0.15em;
  }
  .signal i {
    width: 0.25em;
    background: #0f1222;
    border-radius: 1px;
  }
  .signal i:nth-child(1) {
    height: 0.4em;
  }
  .signal i:nth-child(2) {
    height: 0.6em;
  }
  .signal i:nth-child(3) {
    height: 0.8em;
  }
  .app-head {
    display: flex;
    align-items: center;
    gap: 0.6em;
    margin-top: 1.4em;
  }
  .app-head img {
    width: 2.5em;
    height: 2.5em;
  }
  .app-head strong {
    display: block;
    font-weight: 700;
  }
  .app-head small {
    display: flex;
    align-items: center;
    gap: 0.35em;
    color: #12b76a;
    font-size: 0.8em;
    font-weight: 600;
  }
  .dot {
    width: 0.55em;
    height: 0.55em;
    border-radius: 50%;
    background: currentColor;
    box-shadow: 0 0 0 0.25em rgb(18 183 106 / 0.2);
  }
  .sending {
    margin-top: 1.6em;
    font-size: 1.05em;
  }
  .sending b {
    font-weight: 700;
  }
  .bar {
    height: 0.6em;
    margin-top: 0.6em;
    border-radius: 999px;
    background: #e3e6f3;
    overflow: hidden;
  }
  .bar span {
    display: block;
    height: 100%;
    width: 75%;
    border-radius: inherit;
    background: linear-gradient(90deg, #4353ff, #19c3fb);
    animation: grow 6s ease-in-out infinite;
  }
  @keyframes grow {
    0% {
      width: 55%;
    }
    80%,
    100% {
      width: 92%;
    }
  }
  .thumbs {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.45em;
    margin-top: 1.2em;
  }
  .thumb {
    position: relative;
    aspect-ratio: 1;
    border-radius: 0.55em;
    overflow: hidden;
  }
  .thumb.pending {
    opacity: 0.45;
  }
  .thumb.current::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    box-shadow: inset 0 0 0 0.22em #4353ff;
    background: rgb(67 83 255 / 0.15);
  }
  .badge {
    position: absolute;
    right: 0.3em;
    bottom: 0.3em;
    display: grid;
    place-items: center;
    width: 1.3em;
    height: 1.3em;
    border-radius: 50%;
    background: #12b76a;
    color: #fff;
    box-shadow: 0 0 0 0.15em #fff;
  }
  .badge svg {
    width: 0.8em;
    height: 0.8em;
  }
  .note {
    margin-top: auto;
    padding: 0.7em;
    border-radius: 0.8em;
    background: #e9ecf8;
    color: #5b6178;
    font-size: 0.8em;
    text-align: center;
  }
</style>
