---
import Icon from "./Icon.astro";

const faqs = [
  {
    q: "El navegador dice que el archivo «no se descarga habitualmente»",
    a: "Chrome y Edge lo avisan con los programas nuevos que aún tienen pocas descargas. Abre el menú de la descarga (los tres puntos) y elige <strong>«Conservar»</strong>.",
  },
  {
    q: "Al abrirlo, Windows dice «Windows protegió su PC»",
    a: "Es normal con programas nuevos que todavía no son muy conocidos. Pulsa <strong>«Más información»</strong> y después <strong>«Ejecutar de todas formas»</strong>. Solo pasa la primera vez.",
  },
  {
    q: "Aparece un aviso del Firewall de Windows",
    a: "PhotoBridge necesita permiso para que el móvil pueda conectarse. Marca <strong>«Redes privadas»</strong> y pulsa <strong>«Permitir acceso»</strong>.",
  },
  {
    q: "Escaneo el QR pero la página no carga",
    a: `Casi siempre es cosa de la red. Comprueba esto:
      <ul>
        <li>El móvil está conectado a la <strong>misma wifi</strong> que el ordenador y no está usando datos móviles (4G/5G).</li>
        <li>No estás en una red de <strong>invitados</strong>: suelen impedir que los dispositivos se vean entre sí.</li>
        <li>En Windows la red tiene que ser <strong>privada</strong>: ve a <em>Configuración › Red e Internet › Wi-Fi</em> (o Ethernet), entra en tu red y elige <strong>«Red privada»</strong>.</li>
        <li>PhotoBridge sigue abierto en el ordenador.</li>
      </ul>`,
  },
  {
    q: "¿Dónde se guardan las fotos?",
    a: "En la carpeta <strong>Imágenes › PhotoBridge</strong>. Puedes abrirla o elegir otra con los botones de la ventana de PhotoBridge.",
  },
  {
    q: "¿Qué pasa si se bloquea el móvil o se corta la wifi?",
    a: "Nada grave: los archivos se envían por trozos y PhotoBridge recuerda por dónde iba. Al volver a la página, <strong>sigue donde se quedó</strong>, incluso a mitad de un vídeo grande. Aun así, lo más rápido es dejar la pantalla encendida mientras se envía.",
  },
  {
    q: "¿Funciona con las Live Photos del iPhone?",
    a: `Sí, pero desde el navegador el iPhone solo entrega la <strong>foto</strong>, no el movimiento (es una limitación de iOS). Para guardar también el movimiento:
      <ul>
        <li>En <em>Fotos</em>, abre la Live Photo y toca <strong>Compartir › Guardar como vídeo</strong>.</li>
        <li>Envía ese vídeo con PhotoBridge junto con la foto.</li>
      </ul>`,
  },
  {
    q: "Los vídeos del iPhone llegan con menos calidad",
    a: `Al elegirlos desde la fototeca, el iPhone puede comprimirlos antes de enviarlos. Para mandarlos en calidad original:
      <ul>
        <li>En <em>Fotos</em>, selecciónalos y toca <strong>Compartir › Guardar en Archivos</strong>.</li>
        <li>En PhotoBridge, pulsa <strong>Elegir desde Archivos</strong>, entra en la app Archivos y selecciónalos.</li>
      </ul>`,
  },
  {
    q: "Si envío la misma foto dos veces, ¿se duplica?",
    a: "No. PhotoBridge reconoce las fotos y vídeos que ya tiene el ordenador y no los vuelve a copiar, así que puedes enviar el carrete entero sin miedo.",
  },
  {
    q: "¿Se mantiene la fecha de las fotos?",
    a: "Sí. PhotoBridge lee la fecha real en que se hizo cada foto o vídeo (también en los HEIC y MOV del iPhone) y la aplica al archivo, así que en el ordenador se ordenan bien.",
  },
  {
    q: "¿Puedo ver en el ordenador las fotos que voy recibiendo?",
    a: "Sí. En cuanto el móvil escanea el código, la ventana de PhotoBridge cambia el QR por una galería en directo: verás qué se está recibiendo y las miniaturas de todo lo que llega. Haz clic en cualquiera para abrirla, o pulsa <strong>«Abrir carpeta»</strong> para verlas todas.",
  },
  {
    q: "¿Puedo ver y borrar las fotos desde PhotoBridge?",
    a: "Sí. Haz clic en cualquier miniatura para verla a pantalla completa dentro de PhotoBridge (los vídeos se reproducen ahí mismo). Para borrar, usa la papelera de cada foto o <strong>«Seleccionar»</strong> para borrar varias a la vez. Van a la <strong>Papelera de reciclaje</strong> de Windows, así que puedes recuperarlas si te equivocas.",
  },
  {
    q: "¿Cómo actualizo PhotoBridge?",
    a: "No tienes que hacer nada especial: cuando hay una versión nueva, PhotoBridge te avisa al abrirlo. Pulsa <strong>«Sí»</strong> y en unos segundos se descarga, se instala y se vuelve a abrir solo.",
  },
  {
    q: "¿Funciona si no estoy en casa?",
    a: "No, y es a propósito: el móvil y el ordenador tienen que estar en la misma red. Así tus fotos nunca viajan por internet.",
  },
  {
    q: "¿Alguien de mi wifi podría enviarme fotos?",
    a: "No. El código QR incluye una clave secreta única de tu ordenador y PhotoBridge rechaza cualquier envío que no la tenga.",
  },
];
---

<section id="ayuda" class="section faq-section">
  <div class="container faq-layout">
    <div class="faq-head" data-reveal>
      <span class="eyebrow">Ayuda</span>
      <h2>Preguntas frecuentes</h2>
      <p>Las dudas más habituales la primera vez que usas PhotoBridge.</p>
    </div>

    <div class="faq" data-reveal style="--delay: 100ms">
      {
        faqs.map((item, i) => (
          <details open={i === 3} class:list={{ "is-open": i === 3 }}>
            <summary>
              <span class="question">{item.q}</span>
              <span class="toggle">
                <Icon name="plus" size={18} strokeWidth={2.4} />
              </span>
            </summary>
            <div class="answer">
              <div class="answer-inner" set:html={item.a} />
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq-section {
    background: var(--bg-soft);
    border-block: 1px solid var(--border);
  }
  .faq-layout {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.4fr);
    gap: clamp(32px, 6vw, 80px);
    align-items: start;
  }
  .faq-head {
    position: sticky;
    top: 104px;
  }
  .faq-head h2 {
    font-size: clamp(2rem, 4.4vw, 3rem);
  }
  .faq-head p {
    margin-top: 16px;
    color: var(--muted);
    font-size: 1.1rem;
  }
  .faq {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  details {
    position: relative;
    border-radius: var(--radius);
    background: var(--surface);
    border: 1px solid var(--border);
    box-shadow: var(--shadow-sm);
    transition:
      border-color 0.35s ease,
      box-shadow 0.35s ease,
      transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  details:hover {
    border-color: rgb(67 83 255 / 0.22);
  }
  details.is-open,
  :global(html:not(.js)) details[open] {
    border-color: rgb(67 83 255 / 0.32);
    box-shadow: var(--shadow-md);
  }
  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 20px 22px;
    cursor: pointer;
    list-style: none;
    font: 650 1.05rem/1.35 var(--font-display);
    letter-spacing: -0.01em;
    border-radius: var(--radius);
    user-select: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  .question {
    transition: color 0.3s ease;
  }
  details.is-open .question,
  :global(html:not(.js)) details[open] .question {
    color: var(--brand-1);
  }
  @media (prefers-color-scheme: dark) {
    details.is-open .question {
      color: #9aa5ff;
    }
  }
  .toggle {
    flex: none;
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--bg-soft);
    color: var(--brand-1);
    transition:
      transform 0.45s cubic-bezier(0.3, 1.5, 0.5, 1),
      background-color 0.3s ease,
      color 0.3s ease,
      box-shadow 0.3s ease;
  }
  summary:hover .toggle {
    background: rgb(67 83 255 / 0.12);
  }
  details.is-open .toggle,
  :global(html:not(.js)) details[open] .toggle {
    transform: rotate(135deg);
    background: var(--grad);
    color: #fff;
    box-shadow: var(--glow);
  }
  .answer {
    overflow: hidden;
    color: var(--muted);
  }
  .answer-inner {
    padding: 0 22px 22px;
    transition:
      opacity 0.35s ease,
      transform 0.45s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  :global(.js) details:not(.is-open) .answer-inner {
    opacity: 0;
    transform: translateY(-8px);
  }
  .answer :global(ul) {
    margin: 10px 0 0;
    padding-left: 20px;
  }
  .answer :global(li) {
    margin-bottom: 8px;
  }
  .answer :global(strong) {
    color: var(--text);
    font-weight: 600;
  }

  @media (max-width: 860px) {
    .faq-layout {
      grid-template-columns: 1fr;
    }
    .faq-head {
      position: static;
      text-align: center;
    }
  }
</style>

<script>
  // Abre y cierra las respuestas con una animación suave de altura (el <details> nativo no se anima).
  // Solo hay una abierta a la vez. Sin JavaScript, o con "reducir movimiento", funciona igual pero sin animar.
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
  const EASE = "cubic-bezier(0.2, 0.8, 0.2, 1)";
  const items = [...document.querySelectorAll<HTMLDetailsElement>(".faq details")];
  const running = new WeakMap<HTMLDetailsElement, Animation>();

  function animateHeight(details: HTMLDetailsElement, from: number, to: number, onEnd?: () => void) {
    const answer = details.querySelector<HTMLElement>(".answer")!;
    running.get(details)?.cancel();
    const duration = Math.min(520, 260 + Math.abs(to - from) * 0.6);
    // fill "forwards": al terminar se queda en la altura final hasta que se cierra de verdad (sin parpadeo)
    const animation = answer.animate([{ height: `${from}px` }, { height: `${to}px` }], {
      duration,
      easing: EASE,
      fill: "forwards",
    });
    running.set(details, animation);
    animation.onfinish = () => {
      running.delete(details);
      onEnd?.();
      animation.cancel(); // vuelve a la altura natural del contenido
    };
  }

  function open(details: HTMLDetailsElement) {
    const answer = details.querySelector<HTMLElement>(".answer")!;
    const start = details.open ? answer.offsetHeight : 0;
    details.open = true;
    details.classList.add("is-open");
    if (reduceMotion.matches) return;
    animateHeight(details, start, answer.scrollHeight);
  }

  function close(details: HTMLDetailsElement) {
    const answer = details.querySelector<HTMLElement>(".answer")!;
    details.classList.remove("is-open");
    if (reduceMotion.matches) {
      details.open = false;
      return;
    }
    animateHeight(details, answer.offsetHeight, 0, () => {
      if (!details.classList.contains("is-open")) details.open = false;
    });
  }

  for (const details of items) {
    details.querySelector("summary")!.addEventListener("click", (event) => {
      event.preventDefault();
      if (details.classList.contains("is-open")) {
        close(details);
      } else {
        items.filter((other) => other !== details && other.classList.contains("is-open")).forEach(close);
        open(details);
      }
    });
  }
</script>
